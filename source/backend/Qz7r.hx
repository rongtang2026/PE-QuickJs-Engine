	public static inline var INFO:String = "INFO";
	public static inline var UNOFFICIAL:String = "UNOFFICIAL BUILD - mods and scripts are disabled";
	public static inline var BUILD_OK:String = "[Integrity] build ok";
	public static inline var PKG:String = "DingLing.pe.QuickJs.Engine";
	public static inline var MAPS_PATH:String = "/proc/self/maps";
	public static inline var DEX_EXT:String = ".dex";
	public static inline var SUSPECT_PATHS:String = "/data/local/tmp|/storage/emulated|/sdcard|/data/data/|/data/user/0/";

	public var scriptsAllowed:Bool = false;

	var _c:Dynamic = null;
	var _f:Dynamic = null;
	var _m:Dynamic = null;
	var _v:Dynamic = null;
	var _w:Dynamic = null;
	var _z:Dynamic = null;
