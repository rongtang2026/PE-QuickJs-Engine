	var dismissed:Bool = false;

	public function new()
	{
		if (instance == null) instance = this;
		check();
	}

	public static function boot():Qz7r
	{
		if (instance == null) instance = new Qz7r();
		return instance;
	}

	#if android
	static function jni(name:String, sig:String):Dynamic
	{
		try { return JNICache.createStaticMethod("DingLing/pe/QuickJs/Engine/Qz7", name, sig); }
		catch (e:Dynamic) { return null; }
	}
	#end

	public function check():Bool
	{
		if (dismissed) // CONTINUE WITHOUT MODS keeps scripting off for the whole session
		{
			scriptsAllowed = false;
			return scriptsAllowed;
		}
		#if android
		var a:Dynamic = jni("a", "(I)I");
		var b:Dynamic = jni("b", "()I");
		var c:Dynamic = jni("c", "()I");
		var d:Dynamic = jni("d", "()I");
		if (a == null || b == null || c == null || d == null)
		{
			trace(UNOFFICIAL);
			_c = null;
			_z = "unavailable";
			scriptsAllowed = true;
			return scriptsAllowed;
		}
		_c = a(0);
		_v = b();
		_w = c();
		_f = d();
		_m = scanMaps();
		_cn = PKG;
		_hd = DEX_EXT;
		var ok:Bool = _v == 1 && _w == 0 && _f == 0 && !_m;
		if (k != null) ok = ok && _c == k;
		_z = ok ? "ok" : "modified";
		scriptsAllowed = ok;
		if (ok) trace(BUILD_OK);
		else if (FlxG.state != null) states.SecurityNoticeState.show();
		return scriptsAllowed;
		#else
		var modified:Bool = verifyDesktopPackage();
		_z = modified ? "modified" : "ok";
		scriptsAllowed = !modified;
		if (modified)
		{
			if (FlxG.state != null) states.SecurityNoticeState.show();
		}
		else trace(BUILD_OK);
		return scriptsAllowed;
		#end
	}

	#if !android
	function verifyDesktopPackage():Bool
	{
		var expected:Map<String, String> = PackageManifest.parse();
		for (path in expected.keys())
		{
			// APK zip layout prefixes game files with "assets/"; desktop export strips it.
			// manifest/default.json is regenerated by lime per platform, never identical to the APK one.
			if (path == "assets/manifest/default.json") continue;
			var local:String = path;
			if (local.substr(0, 7) == "assets/") local = local.substr(7);
			if (!sys.FileSystem.exists(local)) return true;
			try
			{
				var bytes:haxe.io.Bytes = sys.io.File.getBytes(local);
				// hex-string comparison: immune to Int sign/overflow (CRCs >= 0x80000000
				// were being mangled by Std.parseInt saturation on cpp)
				var actualHex:String = StringTools.hex(haxe.crypto.Crc32.make(bytes), 8).toUpperCase();
				var expectedHex:String = expected.get(path);
				if (actualHex != expectedHex) return true;
			}
			catch (e:Dynamic) { return true; }
		}
		return false;
	}
	#end

	#if android
	function scanMaps():Bool
	{
		try
		{
			var text:String = File.getContent(MAPS_PATH);
			var suspects:Array<String> = SUSPECT_PATHS.split("|");
			for (line in text.split("\n"))
			{
				if (line.indexOf(DEX_EXT) < 0) continue;
				for (s in suspects)
					if (line.indexOf(s) >= 0) return true;
			}
			return false;
		}
		catch (e:Dynamic) { return false; }
	}
	#end

	public function dismiss():Void dismissed = true;
	public function reason():String return _z == null ? "unknown" : Std.string(_z);
}

